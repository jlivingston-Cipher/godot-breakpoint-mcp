# Node / TypeScript
host/node_modules/
host/dist/
host/dist-test/
host/addon/
host/*.log
npm-debug.log*

# scope_gate.py writes a mutated copy of contract_check.py here and removes it in a
# finally; this is the belt-and-braces for a run killed between the two.
scripts/_scope_gate_mutant.py

# Godot
.godot/
*.import

# Secrets / credentials (never commit)
.env
.env.*
*.pem
*.key

# Editor / OS
.DS_Store
.vscode/
.idea/

# Internal design / development artifacts — keep these out of the public repo.
# (Kept in a local working folder outside the repo; use `git add -f` to override.)
HANDOFF*.md
# 🆕 242 — PR bodies are scratch (215 §6.3), and one reached the tree this session
# by way of a `git add -A` in the container. `terminology_gate.py` counted it and the
# shipped status block said one fewer, which is the smallest possible version of a
# document claiming a tree it was not measured against.
PR_BODY*.md
BACKLOG*.md
COMPETITIVE_*.md
BREADTH_*.md
DEFERRED_*.md
NEXT_STEPS*.md
GO_NO_GO*.md
*_SIGNOFF.md
*_ASSESSMENT.md
PRE_DISTRIBUTION*.md
VALIDATION_REPORT.md
/internal/

# transient / undeletable-via-bridge scratch (delete manually)
_to_delete/

# Python bytecode — scripts/contract_check.py is importable (the negative
# tests and any session that introspects it load it as a module), and the .pyc
# it leaves behind was committed once by a `git add -A`.
__pycache__/
*.py[cod]
.gate_mutation.lock
# 🆕 228 — two scratch directories beside the lock, both write-only safety nets.
#   .gate_mutation.d/     the baseline bytes of files that were ALREADY dirty when a
#                         mutating gate started — the only copy of your uncommitted work
#                         while a gate is rewriting it (`_gate_lock.STASH_DIR`).
#   .gate_mutation.undo/  what `tree_quiet.py --recover` found immediately before it put
#                         anything back, so the recovery itself is never one-way.
.gate_mutation.*/
